---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import WaIcon from '../../components/WaIcon.astro';
import { site } from '../../data/site.js';
---
<Base title="Kalkulator kebutuhan AC dan cold storage" description="Hitung perkiraan PK AC untuk ruangan, atau kapasitas pendingin dan tebal panel cold storage. Gratis dari CV Fabian Teknik, Jombang.">
  <PageHead title="Kalkulator kebutuhan mesin pendingin" lead="Isi ukuran ruangan dan penggunaannya. Hasilnya perkiraan awal untuk perencanaan. Angka pasti kami tentukan setelah survei lokasi." />

  <section class="wrap py-12 sm:py-16">
    <div class="flex flex-wrap gap-2 mb-8" role="radiogroup" aria-label="Jenis perhitungan">
      <label class="chip"><input type="radio" name="mode" value="ac" checked class="sr-only" /><span>AC ruangan</span></label>
      <label class="chip"><input type="radio" name="mode" value="cs" class="sr-only" /><span>Cold storage</span></label>
    </div>

    <!-- AC -->
    <div data-mode="ac" class="grid gap-8 lg:grid-cols-[1.1fr_1fr] items-start">
      <form class="panel grid gap-5" id="f-ac">
        <div class="grid grid-cols-3 gap-3">
          <label class="grid gap-1.5"><span class="font-semibold">Panjang (m)</span><input class="field" name="p" type="number" inputmode="decimal" min="1" step="0.1" value="5" /></label>
          <label class="grid gap-1.5"><span class="font-semibold">Lebar (m)</span><input class="field" name="l" type="number" inputmode="decimal" min="1" step="0.1" value="4" /></label>
          <label class="grid gap-1.5"><span class="font-semibold">Tinggi (m)</span><input class="field" name="t" type="number" inputmode="decimal" min="2" step="0.1" value="3" /></label>
        </div>
        <fieldset>
          <legend class="font-semibold mb-2">Fungsi ruangan</legend>
          <div class="flex flex-wrap gap-2">
            <label class="chip"><input type="radio" name="fungsi" value="500" checked class="sr-only" /><span>Kantor atau kamar</span></label>
            <label class="chip"><input type="radio" name="fungsi" value="600" class="sr-only" /><span>Toko atau ruang rapat</span></label>
            <label class="chip"><input type="radio" name="fungsi" value="750" class="sr-only" /><span>Ruang produksi atau dapur</span></label>
            <label class="chip"><input type="radio" name="fungsi" value="850" class="sr-only" /><span>Ruang server</span></label>
          </div>
        </fieldset>
        <label class="grid gap-1.5"><span class="font-semibold">Jumlah orang biasanya di ruangan</span><input class="field" name="orang" type="number" inputmode="numeric" min="0" step="1" value="4" /></label>
        <label class="check"><input type="checkbox" name="matahari" /><span><span class="font-semibold block">Dinding atau kaca kena matahari langsung</span><span class="text-sm text-steel">Menghadap barat atau timur, atau ruangan di lantai paling atas</span></span></label>
      </form>
      <div class="bg-night text-ice rounded-lg p-6 sm:p-8" aria-live="polite">
        <p class="text-sm text-ice/60">Perkiraan kebutuhan</p>
        <p class="temp text-white text-[4.2rem] leading-none mt-2"><span id="ac-pk">2 PK</span></p>
        <p class="mt-2 text-ice/80"><span id="ac-btu">12.000</span> BTU/jam untuk ruangan <span id="ac-luas">20</span> m²</p>
        <p id="ac-note" class="mt-5 text-[.95rem] text-ice/75 border-t border-white/10 pt-5"></p>
        <a id="ac-wa" href="#" target="_blank" rel="noopener" class="btn btn-signal mt-6"><WaIcon />Minta penawaran unit ini</a>
      </div>
    </div>

    <!-- Cold storage -->
    <div data-mode="cs" hidden class="grid gap-8 lg:grid-cols-[1.1fr_1fr] items-start">
      <form class="panel grid gap-5" id="f-cs">
        <div class="grid grid-cols-3 gap-3">
          <label class="grid gap-1.5"><span class="font-semibold">Panjang (m)</span><input class="field" name="p" type="number" inputmode="decimal" min="1" step="0.1" value="4" /></label>
          <label class="grid gap-1.5"><span class="font-semibold">Lebar (m)</span><input class="field" name="l" type="number" inputmode="decimal" min="1" step="0.1" value="3" /></label>
          <label class="grid gap-1.5"><span class="font-semibold">Tinggi (m)</span><input class="field" name="t" type="number" inputmode="decimal" min="2" step="0.1" value="2.5" /></label>
        </div>
        <fieldset>
          <legend class="font-semibold mb-2">Suhu ruang yang dibutuhkan</legend>
          <div class="grid gap-2">
            <label class="check"><input type="radio" name="suhu" value="chill" checked /><span><span class="font-semibold block">0 sampai 5°C, chiller room</span><span class="text-sm text-steel">Sayur, buah, susu, minuman, daging segar</span></span></label>
            <label class="check"><input type="radio" name="suhu" value="frozen" /><span><span class="font-semibold block">−18°C, ruang beku</span><span class="text-sm text-steel">Ikan, daging, dan makanan beku</span></span></label>
            <label class="check"><input type="radio" name="suhu" value="deep" /><span><span class="font-semibold block">−25°C, penyimpanan jangka panjang</span><span class="text-sm text-steel">Stok beku berbulan-bulan, produk ekspor</span></span></label>
          </div>
        </fieldset>
        <fieldset>
          <legend class="font-semibold mb-2">Seberapa sering pintu dibuka</legend>
          <div class="flex flex-wrap gap-2">
            <label class="chip"><input type="radio" name="pintu" value="1" checked class="sr-only" /><span>Jarang, beberapa kali sehari</span></label>
            <label class="chip"><input type="radio" name="pintu" value="1.2" class="sr-only" /><span>Sering, keluar masuk barang tiap jam</span></label>
          </div>
        </fieldset>
      </form>
      <div class="bg-night text-ice rounded-lg p-6 sm:p-8" aria-live="polite">
        <p class="text-sm text-ice/60">Perkiraan kapasitas pendingin</p>
        <p class="temp text-white text-[4.2rem] leading-none mt-2"><span id="cs-kw">2,6</span> kW</p>
        <p class="mt-2 text-ice/80">untuk ruang <span id="cs-vol">30</span> m³, setara kompresor sekitar <span id="cs-hp">1,5</span> HP</p>
        <dl class="mt-5 border-t border-white/10 pt-5 grid grid-cols-2 gap-4 text-[.95rem]">
          <div><dt class="text-ice/60 text-sm">Tebal panel disarankan</dt><dd class="font-semibold text-white" id="cs-panel">75 mm</dd></div>
          <div><dt class="text-ice/60 text-sm">Perkiraan muatan</dt><dd class="font-semibold text-white" id="cs-muat">7 ton</dd></div>
        </dl>
        <a id="cs-wa" href="#" target="_blank" rel="noopener" class="btn btn-signal mt-6"><WaIcon />Minta survei cold storage</a>
      </div>
    </div>

    <p class="mt-8 text-sm text-steel max-w-2xl">Perhitungan memakai angka acuan umum untuk iklim tropis. Hasil sebenarnya dipengaruhi isolasi bangunan, jenis barang, dan jumlah barang masuk per hari, jadi kami cek ulang saat survei.</p>
  </section>
</Base>

<script define:vars={{ wa: site.wa }}>
  const num = (v, d = 0) => { const n = parseFloat(String(v).replace(',', '.')); return Number.isFinite(n) && n > 0 ? n : d; };
  const id = (n) => n.toLocaleString('id-ID', { maximumFractionDigits: 1 });
  const waUrl = (t) => `https://wa.me/${wa}?text=${encodeURIComponent(t)}`;

  // Pilihan mode
  document.querySelectorAll('input[name="mode"]').forEach((r) => r.addEventListener('change', () => {
    document.querySelectorAll('[data-mode]').forEach((el) => { el.hidden = el.dataset.mode !== r.value; });
  }));

  // Ukuran AC standar di pasaran: [PK, BTU/jam]
  const SIZES = [[0.5, 5000], [0.75, 7000], [1, 9000], [1.5, 12000], [2, 18000], [2.5, 22000], [3, 27000], [5, 45000]];

  function calcAc() {
    const f = document.getElementById('f-ac');
    const p = num(f.p.value, 1), l = num(f.l.value, 1), t = num(f.t.value, 3);
    const luas = p * l;
    const orang = Math.max(0, Math.round(num(f.orang.value, 0)));
    const fungsi = Number(f.querySelector('input[name="fungsi"]:checked').value);
    let btu = luas * fungsi * Math.max(1, t / 3) + Math.max(0, orang - 2) * 500;
    if (f.matahari.checked) btu *= 1.1;
    btu = Math.round(btu / 100) * 100;

    const pick = SIZES.find(([, cap]) => cap >= btu);
    let pk, note;
    if (pick) {
      pk = `${id(pick[0])} PK`;
      note = pick[0] >= 3
        ? 'Untuk kebutuhan sebesar ini, AC cassette atau standing floor biasanya lebih cocok daripada split dinding.'
        : 'Satu unit AC split dengan kapasitas ini sudah cukup untuk ruangan Anda.';
    } else {
      const units = Math.ceil(btu / 27000);
      pk = `${units} × 3 PK`;
      note = 'Ruangan sebesar ini sebaiknya memakai beberapa unit cassette atau sistem AC central. Teknisi kami bantu hitung pembagiannya saat survei.';
    }
    document.getElementById('ac-pk').textContent = pk;
    document.getElementById('ac-btu').textContent = btu.toLocaleString('id-ID');
    document.getElementById('ac-luas').textContent = id(luas);
    document.getElementById('ac-note').textContent = note;
    document.getElementById('ac-wa').href = waUrl(`Halo Fabian Teknik, saya ingin penawaran AC.\n\nRuangan: ${id(p)} × ${id(l)} m, tinggi ${id(t)} m (${id(luas)} m²)\nFungsi: ${f.querySelector('input[name="fungsi"]:checked').nextElementSibling.textContent}\nHasil kalkulator: ${pk}, sekitar ${btu.toLocaleString('id-ID')} BTU/jam`);
  }

  // Beban pendingin per m³ (W) dan tebal panel untuk tiap suhu
  const CS = {
    chill: { w: 55, perHp: 2.0, panel: '75 mm', label: '0 sampai 5°C' },
    frozen: { w: 90, perHp: 1.3, panel: '100 mm', label: '−18°C' },
    deep: { w: 115, perHp: 1.0, panel: '125 sampai 150 mm', label: '−25°C' },
  };

  function calcCs() {
    const f = document.getElementById('f-cs');
    const p = num(f.p.value, 1), l = num(f.l.value, 1), t = num(f.t.value, 2.5);
    const vol = p * l * t;
    const s = CS[f.querySelector('input[name="suhu"]:checked').value];
    const pintu = Number(f.querySelector('input[name="pintu"]:checked').value);
    const kw = Math.max(1, (vol * s.w * pintu) / 1000);
    const hp = Math.max(1, Math.round((kw / s.perHp) * 2) / 2);
    const ton = Math.round(vol * 0.25 * 10) / 10; // sekitar 250 kg per m³ untuk barang dalam palet atau rak

    document.getElementById('cs-kw').textContent = id(Math.round(kw * 10) / 10);
    document.getElementById('cs-vol').textContent = id(Math.round(vol * 10) / 10);
    document.getElementById('cs-hp').textContent = id(hp);
    document.getElementById('cs-panel').textContent = s.panel;
    document.getElementById('cs-muat').textContent = `${id(ton)} ton`;
    document.getElementById('cs-wa').href = waUrl(`Halo Fabian Teknik, saya ingin survei cold storage.\n\nUkuran: ${id(p)} × ${id(l)} × ${id(t)} m (${id(Math.round(vol * 10) / 10)} m³)\nSuhu: ${s.label}\nHasil kalkulator: sekitar ${id(Math.round(kw * 10) / 10)} kW, kompresor ±${id(hp)} HP, panel ${s.panel}`);
  }

  document.getElementById('f-ac').addEventListener('input', calcAc);
  document.getElementById('f-cs').addEventListener('input', calcCs);
  document.querySelectorAll('form').forEach((f) => f.addEventListener('submit', (e) => e.preventDefault()));
  calcAc(); calcCs();
</script>

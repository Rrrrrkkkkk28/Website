---
// Diagram siklus refrigerasi: empat komponen yang dirawat teknisi Fabian Teknik.
// Arah path mengikuti aliran refrigeran, supaya animasi garis putus-putus bergerak searah aliran.
const coil = (x0, x1, y, amp = 12, step = 16) => {
  let d = `M${x0} ${y}`;
  for (let x = x0, up = true; x < x1; x += step, up = !up) d += ` L${Math.min(x + step / 2, x1)} ${y + (up ? -amp : amp)} L${Math.min(x + step, x1)} ${y}`;
  return d;
};
---
<figure class="cycle bg-night text-ice rounded-lg p-5 sm:p-7">
  <svg viewBox="0 0 440 470" class="w-full h-auto" role="img" aria-labelledby="cycle-title cycle-desc">
    <title id="cycle-title">Siklus refrigerasi</title>
    <desc id="cycle-desc">Refrigeran dipompa kompresor ke kondensor untuk membuang panas, lalu melewati katup ekspansi dan masuk ke evaporator untuk menyerap panas dari ruangan, kemudian kembali ke kompresor.</desc>

    <!-- Pipa: panas (amber) di sisi tekanan tinggi, dingin (biru) di sisi tekanan rendah -->
    <g fill="none" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M390 205 V110 H300" stroke="#F2B300" />
      <path d="M140 110 H50 V214" stroke="#D9B565" />
      <path d="M50 256 V360 H140" stroke="#4F9FD8" />
      <path d="M300 360 H390 V265" stroke="#8FB3C9" />
    </g>
    <g class="flow" fill="none" stroke="#fff" stroke-width="2" stroke-dasharray="3 15" stroke-linecap="round" opacity=".7">
      <path d="M390 205 V110 H300" />
      <path d="M140 110 H50 V214" />
      <path d="M50 256 V360 H140" />
      <path d="M300 360 H390 V265" />
    </g>

    <!-- Kondensor -->
    <rect x="140" y="86" width="160" height="48" rx="4" fill="#0F3550" stroke="#F2B300" stroke-width="1.5" />
    <path d={coil(150, 290, 110)} fill="none" stroke="#F2B300" stroke-width="2" />
    <text x="220" y="44" text-anchor="middle" class="nm">Kondensor</text>
    <text x="220" y="66" text-anchor="middle" class="ds">Membuang panas ke luar</text>

    <!-- Evaporator -->
    <rect x="140" y="336" width="160" height="48" rx="4" fill="#0F3550" stroke="#4F9FD8" stroke-width="1.5" />
    <path d={coil(150, 290, 360)} fill="none" stroke="#4F9FD8" stroke-width="2" />
    <text x="220" y="418" text-anchor="middle" class="nm">Evaporator</text>
    <text x="220" y="440" text-anchor="middle" class="ds">Menyerap panas dari ruangan</text>

    <!-- Kompresor -->
    <circle cx="390" cy="235" r="30" fill="#0F3550" stroke="#DCE7EF" stroke-width="1.5" />
    <path d="M374 235 a16 16 0 1 1 16 16" fill="none" stroke="#DCE7EF" stroke-width="2" />
    <path d="M386 247 l5 4 -5 4" fill="none" stroke="#DCE7EF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <text x="346" y="276" text-anchor="end" class="nm">Kompresor</text>
    <text x="346" y="298" text-anchor="end" class="ds">Memompa refrigeran</text>

    <!-- Katup ekspansi -->
    <path d="M32 214 H68 L32 256 H68 Z" fill="#0F3550" stroke="#DCE7EF" stroke-width="1.5" stroke-linejoin="round" />
    <text x="86" y="176" class="nm">Katup ekspansi</text>
    <text x="86" y="198" class="ds">Menurunkan tekanan</text>
  </svg>

  <figcaption class="mt-4 pt-4 border-t border-white/10 text-[.92rem] text-ice/70">
    Empat komponen ini ada di setiap AC, chiller, mesin es, dan cold storage. Kalau satu bermasalah, suhu ruang ikut naik. Teknisi kami memeriksa keempatnya di setiap kunjungan.
    <span class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-[.85rem]">
      <span class="inline-flex items-center gap-2"><span class="h-1 w-5 rounded bg-signal"></span>Sisi panas, tekanan tinggi</span>
      <span class="inline-flex items-center gap-2"><span class="h-1 w-5 rounded bg-[#4F9FD8]"></span>Sisi dingin, tekanan rendah</span>
    </span>
  </figcaption>
</figure>

<style>
  .cycle .nm { fill: #fff; font: 700 20px var(--font-sans); }
  .cycle .ds { fill: rgb(220 231 239 / .6); font: 400 16px var(--font-sans); }
  .cycle .flow path { animation: flow 1.6s linear infinite; }
  @keyframes flow { to { stroke-dashoffset: -18; } }
</style>
